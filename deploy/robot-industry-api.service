[Unit]
Description=Robot industry DeepSeek API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=robot-industry
Group=robot-industry
WorkingDirectory=/opt/robot-industry/current
EnvironmentFile=/etc/robot-industry/api.env
ExecStart=/opt/robot-industry/runtime/bin/node server/index.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
TimeoutStopSec=70

[Install]
WantedBy=multi-user.target
